{{/* VS Code User settings.json lives at a different path per OS - only
  one of these two targets actually applies on a given machine, the
  other's source file (see .chezmoitemplates/vscode-settings.json for
  the shared content) still exists but must never be applied there. */}}
{{ if ne .chezmoi.os "darwin" -}}
Library/Application Support/Code/User/settings.json
{{ end -}}
{{ if ne .chezmoi.os "linux" -}}
.config/Code/User/settings.json
{{ end -}}

{{/* The daily chezmoi update LaunchAgent is macOS-only: launchctl doesn't
  exist elsewhere and the plist would be dead weight. The loader script
  renders empty on other OSes (chezmoi skips empty scripts). */}}
{{ if ne .chezmoi.os "darwin" -}}
Library/LaunchAgents/com.chezmoi.update.plist
.local/bin/chezmoi-update.sh
{{ end -}}

{{/* The opencode wrapper execs the macOS-only OpenCode Desktop app bundle
  CLI; Linux gets the command from the brew formula (packages.yaml). */}}
{{ if ne .chezmoi.os "darwin" -}}
.local/bin/opencode
{{ end -}}
