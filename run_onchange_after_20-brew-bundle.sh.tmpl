#!/bin/bash
# Converges installed packages to exactly what the Brewfile declares.
# Re-runs whenever the rendered Brewfile changes:
# Brewfile hash: {{ include "dot_config/homebrew/Brewfile.tmpl" | sha256sum }}
set -euo pipefail

BREWFILE="{{ .chezmoi.homeDir }}/.config/homebrew/Brewfile"

for b in /opt/homebrew/bin/brew /home/linuxbrew/.linuxbrew/bin/brew /usr/local/bin/brew; do
    if [ -x "$b" ]; then eval "$("$b" shellenv)"; break; fi
done

echo "==> Installing/upgrading declared packages"
brew bundle install --file="$BREWFILE"

{{ if .prune -}}
# --- Destructive phase: remove anything NOT in the Brewfile ---
# Extra flags opt in to non-formula package types. Verify the exact flag names
# for your brew version with: brew bundle cleanup --help
CLEANUP_FLAGS=(--file="$BREWFILE")
{{ if and (eq .chezmoi.os "linux") .gaming -}}
CLEANUP_FLAGS+=(--flatpaks)
{{ end -}}

echo "==> Packages that would be removed:"
brew bundle cleanup "${CLEANUP_FLAGS[@]}"

if [ "${BREW_PRUNE_CONFIRM:-ask}" = "yes" ]; then
    brew bundle cleanup --force "${CLEANUP_FLAGS[@]}"
else
    read -r -p "Proceed with uninstall? [y/N] " reply </dev/tty || reply=n
    case "$reply" in
        [yY]*) brew bundle cleanup --force "${CLEANUP_FLAGS[@]}" ;;
        *)     echo "==> Skipped cleanup. Run manually when ready." ;;
    esac
fi
{{ else -}}
echo "==> Pruning disabled for this machine (set prune = true in chezmoi.toml)"
{{ end -}}
