#!/bin/sh
# Ensures the age private key exists BEFORE chezmoi decrypts any encrypted_ files.
# Priority: existing key file > manual paste.
set -eu

KEY="{{ .chezmoi.homeDir }}/.config/sops/age/keys.txt"

if [ -f "$KEY" ]; then
    exit 0
fi

mkdir -p "$(dirname "$KEY")"
umask 077

echo "==> Paste your age private key (same identity used with sops; AGE-SECRET-KEY-1...), then Ctrl-D:"
cat > "$KEY"

chmod 600 "$KEY"

# Sanity check
if ! grep -q "AGE-SECRET-KEY-1" "$KEY"; then
    echo "ERROR: $KEY does not look like an age identity. Aborting." >&2
    rm -f "$KEY"
    exit 1
fi
echo "==> age key installed at $KEY"
