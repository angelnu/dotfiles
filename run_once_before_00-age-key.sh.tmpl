#!/bin/sh
# Ensures the age private key exists BEFORE chezmoi decrypts any encrypted_ files.
# Priority: existing key > Bitwarden CLI (bw) > rbw > manual paste.
set -eu

KEY="{{ .chezmoi.homeDir }}/.config/chezmoi/key.txt"

if [ -f "$KEY" ]; then
    exit 0
fi

mkdir -p "$(dirname "$KEY")"
umask 077

if command -v bw >/dev/null 2>&1; then
    echo "==> Fetching age key from Bitwarden (item: chezmoi-age-key)"
    # Needs a session: run `export BW_SESSION=$(bw unlock --raw)` first,
    # otherwise bw will prompt interactively.
    bw get notes chezmoi-age-key > "$KEY"
elif command -v rbw >/dev/null 2>&1; then
    echo "==> Fetching age key from Bitwarden via rbw (item: chezmoi-age-key)"
    rbw get chezmoi-age-key > "$KEY"
else
    echo "==> No Bitwarden CLI found."
    echo "    Paste your age private key (AGE-SECRET-KEY-1...), then Ctrl-D:"
    cat > "$KEY"
fi

chmod 600 "$KEY"

# Sanity check
if ! grep -q "AGE-SECRET-KEY-1" "$KEY"; then
    echo "ERROR: $KEY does not look like an age identity. Aborting." >&2
    rm -f "$KEY"
    exit 1
fi
echo "==> age key installed at $KEY"
