{{- /*
  Which role buckets apply to the current machine: "default" always, plus
  whatever tags were selected at `chezmoi init` (see .chezmoi.toml.tmpl,
  [data] roles - "server", "gui", "gaming", "develop", "work", each
  independent, any combination or none). No negation/complementary-pair
  logic needed: every bucket is a positive "install this when tag X is
  present" rule - e.g. what used to be "non_server" (things to skip on the
  headless server) is now just "gui" (things to install when this machine
  has a desktop), selected on every non-server machine instead of implied
  by the absence of "server". JSON-encoded list; parse back with
  `fromJson` after `includeTemplate`.
*/ -}}
{{- $buckets := concat (list "default") (default list (index . "roles")) -}}
{{- $buckets | toJson -}}
