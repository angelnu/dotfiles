{{- /*
  Non-secret env vars for the current user: common (.chezmoidata/env.yaml,
  key env) merged with this user's own overlay
  (.chezmoidata/env-<username>.yaml, key env_per_user_<username> - NOT
  per_user_<username>, see that file's own comment for why: chezmoi
  deep-merges every .chezmoidata/*.yaml file into one combined tree, and
  per_user_<username> is already taken by packages-<username>.yaml for
  an unrelated role -> package type -> os shape) - per-user wins on a key
  collision (confirmed: sprig's `merge $dst $src1 $src2` fills $dst from
  $src1 first, then only fills whatever $src2 has that isn't already
  set, so passing $user before $common makes $user win).

  For SECRET env vars (API keys, tokens, anything that can't be plaintext
  in this public repo) use the per-user env in the encrypted
  .chezmoisecrets/users.yaml.age instead - see modify_dot_bashrc.tmpl,
  modify_dot_profile.tmpl and dot_config/fish/modify_config.fish.tmpl,
  which merge both this and that into what actually gets exported.

  `index`, not dot-notation, for both keys: dot errors on a genuinely
  missing key (e.g. a user with no overlay file at all) instead of
  returning nil like index does - same reason resolved-vscode-extensions
  used it (before that got folded into resolved-packages) and
  private_config.tmpl's own comment on this.
*/ -}}
{{- $common := default dict (index . "env") -}}
{{- $userKey := printf "env_per_user_%s" .chezmoi.username -}}
{{- $user := default dict (index . $userKey) -}}
{{- merge (dict) $user $common | toJson -}}
