{{- /*
  Flat, deduped list of VS Code extension IDs for the current user: the
  shared baseline (.chezmoidata/vscode-extensions.yaml, key
  vscode_extensions) plus this user's own overlay
  (.chezmoidata/vscode-extensions-<username>.yaml, key
  per_user_<username>). No role/OS split needed here unlike
  merged-packages/resolved-packages - an extension ID is the same
  everywhere `code --install-extension` runs, so there's no
  brews/casks/flatpaks-style per-platform naming to resolve.

  `index`, not dot-notation, for both keys: dot errors on a genuinely
  missing key (e.g. a user with no overlay file at all) instead of
  returning nil like index does - same reason private_config.tmpl uses
  it for optional per-host fields.

  Called via `includeTemplate` + `fromJson`, same convention as
  resolved-packages.
*/ -}}
{{- $common := default list (index . "vscode_extensions") -}}
{{- $userKey := printf "per_user_%s" .chezmoi.username -}}
{{- $user := default list (index . $userKey) -}}
{{- concat $common $user | uniq | sortAlpha | toJson -}}
