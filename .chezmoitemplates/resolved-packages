{{- /*
  The single entry point for "what packages apply to this machine".
  Consumers (dot_config/homebrew/Brewfile.tmpl, the brew-bundle and
  rpm-ostree scripts) call ONLY this and get back plain flat lists per
  package type - they never need to know anything about per-user overlays,
  roles, or OS scoping. That's entirely an authoring-time concern in
  packages.yaml/packages-<username>.yaml, not something every consumer
  should have to re-derive for itself (a real bug here otherwise: one
  script iterated .packages.taps directly and broke the moment the
  structure gained an extra level).

  Composes the lower-level partials - merged-packages (deep-merge with the
  per-user overlay, role -> type -> os), role-buckets (which role keys
  apply to this machine) - then walks the merged structure role-first: for
  every applicable role bucket, for every package type it declares,
  concatenate that type's "any-os" + this-machine's-os list into that
  type's running total. Generic over whatever roles/types are actually
  present, so a new one needs zero template changes here.

  JSON-encoded {"taps": [...], "brews": [...], "casks": [...],
  "flatpaks": [...], "rpm_ostree": [...]}; parse back with `fromJson`
  after `includeTemplate`. All five keys are always present (defaulting to
  an empty list) even if no active role bucket ever mentions that type -
  e.g. a headless machine (no "gui" tag) has no "flatpaks" anywhere in
  packages.yaml's role tree, but consumers use plain dot-notation
  (`$pkgs.flatpaks`) which errors on a genuinely missing map key - this
  guarantees it's always at least `[]`, confirmed the hard way (a
  role-less Linux "server" simulation crashed here before this existed).
*/ -}}
{{- $merged := (includeTemplate "merged-packages" .) | fromJson -}}
{{- $roleBuckets := (includeTemplate "role-buckets" .) | fromJson -}}
{{- $resolved := dict -}}
{{- range $roleBuckets -}}
  {{- $roleDict := index $merged . -}}
  {{- if $roleDict -}}
    {{- range $type, $typeVal := $roleDict -}}
      {{- $current := index $resolved $type -}}
      {{- if not $current }}{{ $current = list }}{{ end -}}
      {{- $current = concat $current (default list (index $typeVal "any-os")) -}}
      {{- $current = concat $current (default list (index $typeVal $.chezmoi.os)) -}}
      {{- $_ := set $resolved $type $current -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- range list "taps" "brews" "casks" "flatpaks" "rpm_ostree" -}}
  {{- if not (index $resolved .) }}{{ $_ := set $resolved . list }}{{ end -}}
{{- end -}}
{{- $resolved | toJson -}}
