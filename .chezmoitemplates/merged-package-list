{{- /*
  Flattens one merged category (e.g. $merged.brews, from
  .chezmoitemplates/merged-packages) into the packages actually applicable
  on this machine: for each role bucket in .roleBuckets
  (.chezmoitemplates/role-buckets), takes its "any-os" list plus its
  .os-named list (darwin/linux). JSON-encoded list; parse back with
  `fromJson` after `includeTemplate`.

  Args (dict): catDict (a merged category: role -> os -> list),
  roleBuckets (list of role keys to include, e.g. ["default" "non_server"]),
  os (current .chezmoi.os).
*/ -}}
{{- $result := list -}}
{{- range .roleBuckets -}}
  {{- $roleDict := index $.catDict . -}}
  {{- if $roleDict -}}
    {{- $result = concat $result (default list (index $roleDict "any-os")) -}}
    {{- $result = concat $result (default list (index $roleDict $.os)) -}}
  {{- end -}}
{{- end -}}
{{- $result | toJson -}}
