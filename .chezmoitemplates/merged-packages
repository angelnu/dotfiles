{{- /*
  Deep-merges .packages (.chezmoidata/packages.yaml) with the current
  user's packages-<username>.yaml overlay (key per_user_<username>), one
  level at a time: role (default/server/gui/gaming/develop/work) ->
  package type (taps/brews/casks/flatpaks/rpm_ostree) -> os
  (any-os/darwin/linux). List leaves are concatenated, not overridden -
  sprig's merge/mergeOverwrite treat a list as atomic (one side's list
  replaces the other's entirely), which would silently drop packages
  rather than combine common + per-user. Fully generic: walks whatever
  keys are actually present at each level, so a new role/type/os needs
  zero template changes anywhere.

  Called via `includeTemplate` (not `template` - that only writes output,
  it can't be captured into a variable) and the result parsed back with
  `fromJson`, since chezmoi/Go templates have no other way to return a
  value from a shared template. `index`, not dot-notation, for every
  possibly-missing key: dot errors on a map that lacks the key entirely,
  `index` returns nil. `default list` guards a genuinely nil leaf (e.g. a
  YAML key with only comments under it, no items - parses as null, not []).

  Shared by dot_config/homebrew/Brewfile.tmpl and
  .chezmoiscripts/run_onchange_after_21-rpm-ostree.sh.tmpl - one
  implementation, not two.
*/ -}}
{{- $user := index . (printf "per_user_%s" .chezmoi.username) -}}
{{- if not $user }}{{ $user = dict }}{{ end -}}
{{- $merged := dict -}}
{{- range $role, $roleVal := .packages -}}
  {{- $userRole := index $user $role -}}
  {{- if not $userRole }}{{ $userRole = dict }}{{ end -}}
  {{- $mergedRole := dict -}}
  {{- range $type, $typeVal := $roleVal -}}
    {{- $userType := index $userRole $type -}}
    {{- if not $userType }}{{ $userType = dict }}{{ end -}}
    {{- $mergedType := dict -}}
    {{- range $os, $osVal := $typeVal -}}
      {{- $_ := set $mergedType $os (concat $osVal (default list (index $userType $os))) -}}
    {{- end -}}
    {{- $_ := set $mergedRole $type $mergedType -}}
  {{- end -}}
  {{- $_ := set $merged $role $mergedRole -}}
{{- end -}}
{{- $merged | toJson -}}
