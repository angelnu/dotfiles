{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-plugin-litellm@latest"
  ],
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Phoeniqs MaaS",
      "options": {
        "baseURL": "https://maas.phoeniqs.com/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      }
    },
    "anthropic": {
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      }
    }
  },
  "mcp": {
    "odoo": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-odoo"
      ],
      "enabled": true,
      "environment": {
        "ODOO_URL": "https://odoo.phoenix-technologies.ch",
        "ODOO_DB": "phoenix_technologies",
        "ODOO_API_KEY": "{env:ODOO_API_KEY}",
        "ODOO_USER": "{env:ODOO_USER}",
        "ODOO_YOLO": "read"
      }
    }
  }
}
