{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-plugin-litellm@latest"
  ],
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Phoeniqs MaaS",
      "options": {
        "baseURL": "https://maas.phoeniqs.com/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      }
    },
    "anthropic": {
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      }
    }
  },
  "mcp": {
    "odoo": {
      "type": "remote",
      "url": "https://mcp-odoo-d00053-mcps.pub.basel.kvant.cloud/mcp",
      "enabled": true,
      "oauth": false,
      "timeout": 30000,
      "headers": {
        "X-Odoo-Url": "https://odoo.phoenix-technologies.ch",
        "X-Odoo-Db": "phoenix_technologies",
        "X-Odoo-Api-Key": "{env:ODOO_API_KEY}"
      }
    }
  }
}
