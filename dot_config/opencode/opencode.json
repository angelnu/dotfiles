{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-plugin-litellm@latest"
  ],
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Phoeniqs MaaS",
      "options": {
        "baseURL": "https://maas.phoeniqs.com/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      }
    },
    "anthropic": {
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      }
    }
  },
  "mcp": {
    "servers": {
      "home-assistant": {
        "type": "remote",
        "url": "https://ha.angelnu.com/api/mcp"
      }
    }
  },
  "instructions": [
    "~/.config/opencode-phoeniqs-settings-local/.opencode/rules/*.md",
    "~/.config/opencode-phoeniqs-settings-local/.opencode/rules/atlassian/*.md"
  ]
}
