{{- /*
  Personal email for git commits, pulled in by .gitconfig's
  [includeIf "gitdir:~/code/home/"] (see dot_gitconfig.tmpl) - ~/code/home
  overrides the broader ~/code work mapping, and this include must come
  AFTER work.inc's in .gitconfig for that to win. Rendered per user from
  the same encrypted users.yaml.age entry .gitconfig's [user] section
  reads, so this scales to every user without per-user files.
*/ -}}
{{- $usersYaml := (include ".chezmoisecrets/users.yaml.age") | decrypt | fromYaml -}}
{{- $me := index $usersYaml.users .chezmoi.username -}}
{{- $email := "" -}}
{{- if $me -}}
  {{- $email = $me.personal_email -}}
{{- end -}}
[user]
    email = {{ $email }}
