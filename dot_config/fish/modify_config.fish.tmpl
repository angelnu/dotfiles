#!/bin/bash
# chezmoi owns the static block below (this file's own template content,
# rendered before this script even runs since it's a modify_*.tmpl -
# chezmoi templates first, then executes the result). Rancher Desktop's
# installer additionally appends its own "MANAGED BY RANCHER DESKTOP"
# PATH block directly to this file - confirmed the hard way: unlike
# ~/.bashrc (see modify_dot_bashrc, same reasoning), it patches
# config.fish directly rather than relying on fish sourcing an rc file it
# doesn't have. A plain templated file reverted that block on every apply
# and printed a "changed since chezmoi last wrote it" warning on every
# `chezmoi update` - this modify_ script instead reads the file's current
# content (stdin), pulls out Rancher's block if present, and re-appends
# it after our own content so it survives untouched instead of fighting
# chezmoi forever.
set -euo pipefail

RANCHER_BLOCK="$(sed -n '/^### MANAGED BY RANCHER DESKTOP START/,/^### MANAGED BY RANCHER DESKTOP END/p')"

cat <<'CHEZMOI_MANAGED'
# Homebrew environment (formulae/casks come from .chezmoidata/packages.yaml).
# Runs for every fish invocation (login/non-login, interactive or not) -
# same semantics as home-manager's old `programs.fish.shellInit`.
for b in /opt/homebrew/bin/brew /home/linuxbrew/.linuxbrew/bin/brew /usr/local/bin/brew
    if test -x $b
        eval ($b shellenv fish)
        break
    end
end

{{- if eq .chezmoi.os "linux" }}
# macOS has its own always-running launchd ssh-agent (SSH_AUTH_SOCK already
# set for every session) - Linux doesn't, so nothing here connects to an
# agent at all unless one is started first. `keychain` starts one (or
# reuses an already-running one across shell sessions/tabs) and exports
# SSH_AUTH_SOCK/SSH_AGENT_PID here - with no key names given, it only does
# that agent bootstrap and doesn't try to load anything itself; `ssh-add`
# below (using its own standard default names) handles loading whatever
# keys are actually present, same as it already does on macOS. Without the
# bootstrap here, git commit signing (gpg.format = ssh) silently fails on
# Linux - confirmed the hard way, `ssh-add` has nothing to connect to
# otherwise.
if type -q keychain
    SHELL=(which fish) keychain --quiet --eval | source
end
{{- end }}

# Load default SSH keys into the agent on every shell start.
ssh-add
CHEZMOI_MANAGED

if [ -n "$RANCHER_BLOCK" ]; then
    echo
    printf '%s\n' "$RANCHER_BLOCK"
fi
