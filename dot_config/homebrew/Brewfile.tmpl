{{- /*
  Rendered from .chezmoidata/packages.yaml — this file IS the desired
  state, merged with per-user extras from .chezmoidata/packages-<username>.yaml
  and filtered down to what applies to this machine, via
  .chezmoitemplates/resolved-packages (the single source of truth for
  "what packages apply here" - shared with the brew-bundle and rpm-ostree
  scripts, so this file doesn't need to know anything about per-user
  overlays, roles, or OS scoping itself).
*/ -}}
{{- $pkgs := (includeTemplate "resolved-packages" .) | fromJson -}}
{{- range $pkgs.taps }}
tap "{{ . }}"
{{ end }}
{{ range $pkgs.brews -}}
brew "{{ . }}"
{{ end -}}
{{- if eq .chezmoi.os "darwin" }}
{{ range $pkgs.casks -}}
cask "{{ . }}"
{{ end -}}
{{ range $pkgs.mas -}}
mas "{{ .name }}", id: {{ .id }}
{{ end -}}
{{- end }}
{{- if eq .chezmoi.os "linux" }}
{{ range $pkgs.flatpaks -}}
flatpak "{{ . }}"
{{ end -}}
{{- end }}
