{{/* Rendered from .chezmoidata/packages.yaml — this file IS the desired state. */}}
{{- range .packages.taps }}
tap "{{ . }}"
{{ end -}}
{{- $brews := .packages.brews.common }}
{{- $osBrews := index .packages.brews .chezmoi.os }}
{{- if $osBrews }}{{ $brews = concat $brews $osBrews }}{{ end }}
{{ range $brews -}}
brew "{{ . }}"
{{ end -}}
{{- if eq .chezmoi.os "darwin" }}
{{ range .packages.casks -}}
cask "{{ . }}"
{{ end -}}
{{- end }}
{{- if eq .chezmoi.os "linux" }}
{{ range .packages.flatpaks.common -}}
flatpak "{{ . }}"
{{ end -}}
{{- if not .server }}
{{ range .packages.flatpaks.non_server -}}
flatpak "{{ . }}"
{{ end -}}
{{- end }}
{{- end }}
