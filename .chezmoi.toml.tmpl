{{/* Prompted once per machine, stored in ~/.config/chezmoi/chezmoi.toml */}}
{{/* mac vs. linux is detected from .chezmoi.os; "role" only distinguishes gaming rigs. */}}
{{- $role := promptChoiceOnce . "role" "Machine role" (list "default" "gaming") -}}
{{- $prune := promptBoolOnce . "prune" "Remove packages/files not declared in the repo (prune)" true -}}

{{/*
  The age identity must exist BEFORE chezmoi decrypts any encrypted_ files,
  which it does while building its target state during `apply` - before any
  run_once_before_ script gets a chance to run. So this has to happen here,
  during `init`, which always fully completes first (even inside a combined
  `init --apply`). Plain promptString (not …Once) so the raw key is never
  written into chezmoi.toml's [data] - it only exists transiently in this
  template's execution and in the identity file itself.
*/}}
{{- $ageKeyPath := joinPath .chezmoi.homeDir ".config" "sops" "age" "keys.txt" -}}
{{- if not (stat $ageKeyPath) -}}
  {{- $ageKey := promptString "Age private key (same identity used with sops; AGE-SECRET-KEY-1...; leave blank if you'll place the file yourself)" "" -}}
  {{- if $ageKey -}}
    {{- $ignored := exec "sh" "-c" "mkdir -p \"$(dirname \"$1\")\" && umask 077 && printf '%s\n' \"$2\" > \"$1\" && chmod 600 \"$1\"" "sh" $ageKeyPath $ageKey -}}
  {{- end -}}
{{- end -}}

{{/*
  Name/email are looked up from .chezmoisecrets/users.yaml.age, keyed by the
  system username - keeps them out of chezmoi's own promptStringOnce cache
  (which would otherwise store them, and any future users added to the
  dictionary, unencrypted in each machine's own chezmoi.toml) and out of the
  repo in plaintext (it's a public repo, other people's names/emails don't
  belong in it even if yours already is via commit metadata). Requires the
  age identity above to already exist, same as any other encrypted_ file.
  Falls back to prompting if the username isn't in the dictionary.

  NOT under .chezmoidata/: chezmoi eagerly parses every file in that
  directory as one of its known data formats (yaml/json/toml/...) on every
  command, not just `init` - an unrecognized extension like .age is a hard
  error on every future `apply`/`diff`/`update`, not only here. A sibling
  .chezmoisecrets/ directory isn't special to chezmoi, so it's left alone
  and only read explicitly, right here, via `include`.
*/}}
{{- $usersYaml := (include ".chezmoisecrets/users.yaml.age") | decrypt | fromYaml -}}
{{- $me := index $usersYaml.users .chezmoi.username -}}
{{- $name := "" -}}
{{- $email := "" -}}
{{- if $me -}}
  {{- $name = $me.name -}}
  {{- $email = $me.email -}}
{{- else -}}
  {{- $name = promptStringOnce . "name" (printf "Full name for git commits (user %q isn't in .chezmoisecrets/users.yaml.age)" .chezmoi.username) "" -}}
  {{- $email = promptStringOnce . "email" "Git email for this machine" "" -}}
{{- end -}}

encryption = "age"

[age]
    # Private key: same identity used with sops. Prompted for above, during
    # `chezmoi init`, or drop the file at this path yourself beforehand.
    identity = "{{ .chezmoi.homeDir }}/.config/sops/age/keys.txt"
    # Public key: safe to commit.
    recipient = "age19zycawkart4t4l7a238w0n2w0rmw6anjadwv9yr3ce3js4dz3dcqqgkvsw"

[data]
    role = {{ $role | quote }}
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    user = {{ .chezmoi.username | quote }}
    gaming = {{ eq $role "gaming" }}
    # The only non-gaming Linux machine today is the dev server.
    # Update this when new roles are added if they should count as a server too.
    server = {{ and (eq .chezmoi.os "linux") (eq $role "default") }}
    prune = {{ $prune }}

[diff]
    exclude = ["scripts"]

[edit]
    command = "code"
    args = ["--wait"]
