{{/* Prompted once per machine, stored in ~/.config/chezmoi/chezmoi.toml */}}
{{/* mac vs. linux is detected from .chezmoi.os; "role" distinguishes headless servers and the gaming machine. */}}
{{- $role := promptChoiceOnce . "role" "Machine role" (list "default" "server" "gaming") -}}

{{/*
  The age identity must exist BEFORE chezmoi decrypts any encrypted_ files,
  which it does while building its target state during `apply` - before any
  run_once_before_ script gets a chance to run. So this has to happen here,
  during `init`, which always fully completes first (even inside a combined
  `init --apply`). Plain promptString (not …Once) so the raw key is never
  written into chezmoi.toml's [data] - it only exists transiently in this
  template's execution and in the identity file itself.
*/}}
{{- $ageKeyPath := joinPath .chezmoi.homeDir ".config" "sops" "age" "keys.txt" -}}
{{- if not (stat $ageKeyPath) -}}
  {{- $ageKey := promptString "Age private key (same identity used with sops; AGE-SECRET-KEY-1...; leave blank if you'll place the file yourself)" "" -}}
  {{- if $ageKey -}}
    {{- /* /bin/sh (absolute), not bare "sh" - see the matching note in dot_gitconfig.tmpl for why. */ -}}
    {{- $ignored := exec "/bin/sh" "-c" "mkdir -p \"$(dirname \"$1\")\" && umask 077 && printf '%s\n' \"$2\" > \"$1\" && chmod 600 \"$1\"" "sh" $ageKeyPath $ageKey -}}
  {{- end -}}
{{- end -}}

{{- /*
  Read via `include` + `fromYaml`, NOT the auto-merged `.identities` data -
  confirmed by testing that the merge pass that exposes `.chezmoidata/*.yaml`
  as top-level template data hasn't happened yet this early during `init`
  (`.packages` is equally absent here, same reason). `include` reads the raw
  source file directly regardless, so it works at this point.
*/ -}}
{{- $identities := (include ".chezmoidata/identities.yaml" | fromYaml).identities -}}
{{- $identity := index $identities .chezmoi.username -}}
{{- if not $identity -}}
  {{ fail (printf "no entry for %q in .chezmoidata/identities.yaml - add one before running chezmoi init" .chezmoi.username) }}
{{- end -}}

encryption = "age"

[age]
    # Private key: same identity used with sops. Prompted for above, during
    # `chezmoi init`, or drop the file at this path yourself beforehand.
    identity = "{{ .chezmoi.homeDir }}/.config/sops/age/keys.txt"
    # Public key: safe to commit. Looked up per-username from
    # .chezmoidata/identities.yaml, so each person encrypts new secrets to
    # their own key, not a single shared one.
    recipient = {{ $identity.age_recipient | quote }}

[data]
    role = {{ $role | quote }}
    user = {{ .chezmoi.username | quote }}
    server = {{ eq $role "server" }}
    gaming = {{ eq $role "gaming" }}
    prune = true

[diff]
    exclude = ["scripts"]

[edit]
    command = "code"
    args = ["--wait"]
