{{- $usersYaml := (include ".chezmoisecrets/users.yaml.age") | decrypt | fromYaml -}}
{{- $me := index $usersYaml.users .chezmoi.username -}}
{{- if and $me $me.nextcloud -}}
#!/bin/bash
# Reminds you (doesn't act) if a Nextcloud account isn't connected yet on
# this machine - never runs Nextcloud itself, since that would be an
# intrusive GUI launch during an unattended `chezmoi update` (e.g. the
# daily auto-update timer). The personal server always applies; the work
# server only on machines tagged "work". Server URLs live in the encrypted
# users.yaml.age secret, not here, so they aren't public on GitHub for
# script kiddies to scan for.
#
# Detection is best-effort: the client's internal config format/location
# isn't guaranteed stable across versions - confirmed the hard way that
# macOS v33+ moved to a sandboxed Containers path, breaking the older
# Application Support location, so this checks every known candidate
# rather than trusting just one.
set -euo pipefail

CANDIDATES=(
    "{{ .chezmoi.homeDir }}/Library/Application Support/Nextcloud/nextcloud.cfg"
    "{{ .chezmoi.homeDir }}/Library/Containers/com.nextcloud.desktopclient/Data/Library/Preferences/Nextcloud/nextcloud.cfg"
    "{{ .chezmoi.homeDir }}/.config/Nextcloud/nextcloud.cfg"
)

is_connected() {
    local url="$1" rc host cfg_verdict=""
    host="${url#*://}"
    for f in "${CANDIDATES[@]}"; do
        [ -f "$f" ] || continue
        grep -qF "$url" "$f" 2>/dev/null
        rc=$?
        if [ $rc -eq 0 ]; then return 0; fi
        if [ $rc -eq 1 ]; then cfg_verdict="disconnected"; break; fi
        # rc 2 = unreadable - try the next candidate
    done
    # A readable cfg that lacks the URL is authoritative: not connected.
    [ "$cfg_verdict" = "disconnected" ] && return 1
    # Every cfg candidate was unreadable: macOS TCC protects other apps'
    # containers from processes without Full Disk Access - confirmed the
    # hard way 2026-10-18: client v34 keeps its nextcloud.cfg ONLY in
    # ~/Library/Containers/com.nextcloud.desktopclient/ and -r, head and
    # grep are ALL denied from a plain terminal AND from the LaunchAgent's
    # unattended update, which made this reminder nag daily even though
    # both accounts are configured. Fall back to the File Provider mounts:
    # the v3+ client mounts each connected account under
    # ~/Library/CloudStorage/ (readable, no TCC) - a mount named after the
    # account's host is proof the account is set up.
    [ -d "$HOME/Library/CloudStorage" ] || return 1
    ls "$HOME/Library/CloudStorage" 2>/dev/null | grep -qF "$host" && return 0
    return 1
}

{{- $accounts := dict $usersYaml.nextcloud_servers.angelnu $me.nextcloud.angelnu }}
{{- if has "work" (default list .roles) }}
{{- $_ := set $accounts $usersYaml.nextcloud_servers.kvant $me.nextcloud.kvant }}
{{- end }}
{{ range $url, $user := $accounts }}
if ! is_connected {{ $url | quote }}; then
    echo "==> Nextcloud account not connected: {{ $url }} ({{ $user }})"
{{- if eq $.chezmoi.os "darwin" }}
    echo "    Run: open -a Nextcloud --args --overrideserverurl {{ $url }}"
{{- else }}
    echo "    Run: nextcloud --overrideserverurl {{ $url }}"
{{- end }}
fi
{{ end -}}
{{- end -}}
