{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Makes ~/.config a symlink to ~/Library/Application Support, so
# XDG-following tools (fish, chezmoi itself, etc.) share the "proper" macOS
# config location instead of a separate ~/.config tree.
#
# Runs before everything else (numbered ahead of 10-install-homebrew) since
# other scripts and chezmoi's own managed targets write under ~/.config -
# this needs to be in place first, not migrated around afterward.
set -euo pipefail

CONFIG_DIR="{{ .chezmoi.homeDir }}/.config"
APPSUPPORT_DIR="{{ .chezmoi.homeDir }}/Library/Application Support"

if [ -L "$CONFIG_DIR" ] && [ "$(readlink "$CONFIG_DIR")" = "$APPSUPPORT_DIR" ]; then
    exit 0
fi

mkdir -p "$APPSUPPORT_DIR"

if [ -d "$CONFIG_DIR" ] && [ ! -L "$CONFIG_DIR" ]; then
    echo "==> migrating existing ~/.config content into ~/Library/Application Support"
    # File-by-file, not directory-by-directory: things like
    # ~/Library/Application Support/fish or .../homebrew commonly already
    # exist (fish stores its own data there by default on macOS, separate
    # from config; some casks/formulae write metadata there too) without
    # actually containing anything of ours - those need to merge, not block.
    #
    # Deliberately not rsync --remove-source-files: combined with
    # --ignore-existing, rsync treats a *skipped* file as "transferred" and
    # deletes the source anyway - silently destroys exactly the file a
    # collision is supposed to protect. Confirmed this the hard way before
    # catching it in testing. Plain `mv`, one file at a time, has no such
    # failure mode.
    collision=0
    while IFS= read -r -d '' src; do
        rel="${src#"$CONFIG_DIR"/}"
        dest="$APPSUPPORT_DIR/$rel"
        if [ -e "$dest" ]; then
            echo "WARNING: $dest already exists, leaving $src in place (not migrated)" >&2
            collision=1
        else
            mkdir -p "$(dirname "$dest")"
            mv "$src" "$dest"
        fi
    done < <(find "$CONFIG_DIR" -type f -print0)

    find "$CONFIG_DIR" -type d -empty -delete 2>/dev/null || true

    if [ "$collision" = "1" ] || [ -d "$CONFIG_DIR" ]; then
        echo "ERROR: ~/.config still has un-migrated entries (see warnings above)," >&2
        echo "       leaving it as a real directory - resolve manually, then re-run." >&2
        exit 1
    fi
fi

ln -s "$APPSUPPORT_DIR" "$CONFIG_DIR"
echo "==> ~/.config is now a symlink to ~/Library/Application Support"
{{ end -}}
