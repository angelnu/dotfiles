{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Symlinks ~/.config/fish and ~/.config/homebrew to their real locations
# under ~/Library/Application Support, so those two tools share the
# "proper" macOS config location. Scoped to just these two subdirectories,
# not the whole ~/.config root: chezmoi validates the entire source tree
# structurally, so a directory-typed entry (dot_config/systemd, needed as a
# real directory on Linux) and a symlink-typed entry for the same target
# can never coexist, even behind OS-conditional ignore rules - confirmed
# this the hard way. Real content for fish/homebrew lives under
# Library/Application Support/ as its own independent target; the matching
# dot_config/fish and dot_config/homebrew entries are fully excluded from
# chezmoi's managed state on darwin (see .chezmoiignore), so chezmoi never
# has a reason to touch these paths itself and re-clobber the symlinks -
# verified stable across repeated applies before relying on that.
set -uo pipefail

APPSUPPORT="{{ .chezmoi.homeDir }}/Library/Application Support"
mkdir -p "{{ .chezmoi.homeDir }}/.config" "$APPSUPPORT/fish" "$APPSUPPORT/homebrew"

overall_failure=0
for name in fish homebrew; do
    link="{{ .chezmoi.homeDir }}/.config/$name"
    target="$APPSUPPORT/$name"

    if [ -L "$link" ] && [ "$(readlink "$link")" = "$target" ]; then
        continue
    fi

    if [ -e "$link" ] && [ ! -L "$link" ]; then
        echo "==> migrating existing $link content into $target"
        # File-by-file: things already in $target (fish stores its own
        # data there by default on macOS; homebrew/casks write metadata
        # there too) need to merge, not block. Plain mv, never
        # rsync --remove-source-files --ignore-existing: that combination
        # silently deletes a skipped (colliding) source file without ever
        # copying it - confirmed this destroys data before it ever ran for
        # real.
        collision=0
        while IFS= read -r -d '' src; do
            rel="${src#"$link"/}"
            dest="$target/$rel"
            if [ -e "$dest" ]; then
                echo "WARNING: $dest already exists, leaving $src in place (not migrated)" >&2
                collision=1
            else
                mkdir -p "$(dirname "$dest")"
                mv "$src" "$dest"
            fi
        done < <(find "$link" -type f -print0)
        find "$link" -type d -empty -delete 2>/dev/null || true

        if [ "$collision" = "1" ] || [ -e "$link" ]; then
            echo "ERROR: $link still has un-migrated entries (see warnings above)," >&2
            echo "       leaving it as-is - resolve manually, then re-run." >&2
            overall_failure=1
            continue
        fi
    fi

    ln -sf "$target" "$link"
done

exit "$overall_failure"
{{ end -}}
