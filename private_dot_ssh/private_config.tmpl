{{- $me := index .identities .chezmoi.username -}}
{{- $checkCasaCmd := "ping -c1 -W1 dev.lan" | quote -}}
{{- /*
  casa is special - it's the jump host everything else routes through when
  off the home LAN - so it stays a literal block rather than folding it
  into the generic map below; forcing that genuinely different case
  through machinery built for the common case would make both harder to
  read, not easier. Add a new "regular" machine (reachable directly by
  its own hostname, jumping through casa otherwise) by adding an entry
  here instead of copy-pasting a whole Host/Match block. "user" is
  optional and defaults to the current chezmoi username; `index`, not
  dot-notation, since dot errors on a key a given host's dict doesn't
  define at all.
*/ -}}
{{- $hosts := dict
    "nas" (dict "hostname" "nas.home.prod.angelnu.com" "user" $me.nas_user)
    "okd-service" (dict "hostname" "192.168.5.250" "user" "ansible")
-}}
{{- /* pve1..pve6: same hostname-equals-alias, same root user - generate
  rather than repeat 6 near-identical entries by hand. */ -}}
{{- range $n := until 6 -}}
  {{- $name := printf "pve%d" (add1 $n) -}}
  {{- $_ := set $hosts $name (dict "hostname" $name "user" "root") -}}
{{- end -}}
Host *
    AddKeysToAgent yes
    ForwardAgent yes

Host casa
    Port 22322
    HostName casa96.angelnu.com
    User {{ .chezmoi.username }}
Match originalhost casa exec {{ $checkCasaCmd }}
    Port 22
    HostName dev.lan
{{ range $host, $cfg := $hosts }}
Host {{ $host }}
    Port 22
    HostName {{ $cfg.hostname }}
    User {{ default $.chezmoi.username (index $cfg "user") }}
Match originalhost {{ $host }} !exec {{ $checkCasaCmd }}
    ProxyJump casa
{{ end -}}
