{{- /*
  name/email come from .chezmoisecrets/users.yaml.age (encrypted, keyed by
  system username) rather than being prompted at `chezmoi init` - this is
  the only place they're needed. `decrypt` works fine here (unlike inside
  .chezmoi.toml.tmpl, which produces the [age] config decrypt itself needs -
  a chicken-and-egg problem confirmed by hitting it on a fresh machine): by
  the time this template renders during `apply`, [age] is already loaded
  from the config that a prior `chezmoi init` already generated.
*/ -}}
{{- $usersYaml := (include ".chezmoisecrets/users.yaml.age") | decrypt | fromYaml -}}
{{- $me := index $usersYaml.users .chezmoi.username -}}
{{- $name := "" -}}
{{- $email := "" -}}
{{- if $me -}}
  {{- $name = $me.name -}}
  {{- $email = $me.email -}}
{{- end -}}
{{- /*
  signingKey is derived from the per-user encrypted private key (not read
  back from ~/.ssh/id_ed25519.pub - that file doesn't exist yet at this
  point: all target files render before any run_after_ script, including
  the one that derives it, so reading it here would only work on the
  *second* apply). ssh-keygen -y needs a real file, not stdin, so the
  decrypted key is written to a private tempfile via `output`, exactly
  the same "pass secret as a positional shell arg, not interpolated into
  the script body" pattern .chezmoi.toml.tmpl already uses for the age key.

  `/bin/sh` (absolute) rather than bare "sh", and an explicit curated PATH
  inside the script for `ssh-keygen`/`mktemp` - both resolved by bare name
  via chezmoi's `output`, which does a $PATH lookup on whatever the calling
  shell inherited. Confirmed the hard way: on a machine with a stale/broken
  ~/.nix-profile still ahead of Homebrew and system paths, that resolved to
  the nix-profile's own (incompatible) `sh`, and ssh-keygen failed with an
  opaque "error in libcrypto". Absolute path for the shell itself, plus a
  known-good PATH for what runs inside it, sidesteps whatever's ambient.

  `printf '%s\n'`, not `'%s'` - matches the age-key bootstrap in
  .chezmoi.toml.tmpl, and for the same reason: ssh-keygen -y fails with an
  equally opaque "invalid format" if the private key file it's given
  doesn't end in a newline. Confirmed the hard way too - a key pasted into
  an editor from a source file that itself lacked a trailing newline hits
  this. If $1 already ends in a newline, this just adds a second trailing
  one - confirmed ssh-keygen -y parses that fine too, so it's safe either way.
*/ -}}
{{- $signingKey := "" -}}
{{- if index $.identities .chezmoi.username -}}
  {{- $privKey := include (printf ".chezmoisecrets/ssh/%s/id_ed25519.age" .chezmoi.username) | decrypt -}}
  {{- $signingKey = output "/bin/sh" "-c" "PATH=\"/opt/homebrew/bin:/opt/homebrew/sbin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin\"; umask 077; f=$(mktemp); trap 'rm -f \"$f\"' EXIT; printf '%s\n' \"$1\" > \"$f\"; ssh-keygen -y -f \"$f\"" "sh" $privKey | trim -}}
{{- end -}}
{{- /*
  The work root for the per-directory includeIf below is per user: angel's
  repos live under ~/code (the layout the committed config was written
  for), mireille's under ~/Workspace. A username gate keeps each user's
  rendered .gitconfig pointing at their own root - no per-user files.
*/ -}}
{{- $workRoot := "~/code" -}}
{{- if eq .chezmoi.username "mireille" -}}
{{- $workRoot = "~/Workspace" -}}
{{- end -}}
{{- /*
  pull.rebase is per user too: mireille wants merge-on-pull (keep history
  as it happened; conflicts resolve in one merge commit instead of
  re-playing local commits), angel keeps the rebase-on-pull default.
*/ -}}
{{- $pullRebase := "true" -}}
{{- if eq .chezmoi.username "mireille" -}}
{{- $pullRebase = "false" -}}
{{- end -}}
[user]
    name = {{ $name }}
    email = {{ $email }}
    # Literal key value (not a path) so this still works inside dev
    # containers, where .gitconfig gets mounted/copied in but ~/.ssh does
    # not - signing there relies on the forwarded ssh-agent instead.
    signingKey = "{{ $signingKey }}"
# Per-directory commit emails: everything under the work root commits as
# work, except <work root>/home (personal). The root is per user (see the
# $workRoot assignment above). These includeIf blocks sit AFTER the
# [user] section (includes are processed in file order, so included values
# override it), and the home rule must come AFTER the broader work-root one
# (later includes win). The .inc files render per user from the same vault
# entry above; in dev containers they don't exist and git silently ignores
# a missing include path, so the global [user] email applies there.
[includeIf "gitdir:{{ $workRoot }}/"]
    path = ~/.config/git/work.inc
[includeIf "gitdir:{{ $workRoot }}/home/"]
    path = ~/.config/git/personal.inc
[init]
    defaultBranch = main
[pull]
    # Merge on pull for mireille, rebase for angel (see the $pullRebase
    # gate at the top - same per-user pattern as $workRoot).
    rebase = {{ $pullRebase }}
[rebase]
    autoStash = true
[commit]
    gpgSign = true
[tag]
    gpgSign = true
[gpg]
    format = ssh
[diff "sopsdiffer"]
    textconv = "sops -d"
{{ if eq .chezmoi.os "darwin" }}
[credential]
    helper = osxkeychain
{{ end }}
