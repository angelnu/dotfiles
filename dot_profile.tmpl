# POSIX-shell counterpart to dot_config/fish/config.fish.tmpl - same
# Homebrew/ssh-agent bootstrap, for bash/sh/dev-container use rather than
# fish (the login shell). Sourced by ~/.bashrc too (bash's own login-shell
# lookup already finds this directly, since no ~/.bash_profile exists).
for b in /opt/homebrew/bin/brew /home/linuxbrew/.linuxbrew/bin/brew /usr/local/bin/brew; do
    if [ -x "$b" ]; then eval "$("$b" shellenv)"; break; fi
done

{{- if eq .chezmoi.os "linux" }}
# macOS has its own always-running launchd ssh-agent (SSH_AUTH_SOCK already
# set for every session) - Linux doesn't, so nothing here connects to an
# agent at all unless one is started first. `keychain` starts one (or
# reuses an already-running one across shell sessions/tabs) and exports
# SSH_AUTH_SOCK/SSH_AGENT_PID here - with no key names given, it only does
# that agent bootstrap and doesn't try to load anything itself; `ssh-add`
# below (using its own standard default names) handles loading whatever
# keys are actually present. Without the bootstrap here, git commit
# signing (gpg.format = ssh) silently fails - same issue this fixed for
# fish, just needed here too for bash/sh sessions and scripts that don't
# go through a fish session at all.
if command -v keychain >/dev/null 2>&1; then
    eval "$(keychain --quiet --eval)"
fi
{{- end }}

# Load default SSH keys into the agent on every shell start.
ssh-add
