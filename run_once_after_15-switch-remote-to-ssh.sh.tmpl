#!/bin/bash
# If this repo was cloned over HTTPS (e.g. via gh's browser/2FA login), switch
# the remote to SSH now that our SSH key is in place - `chezmoi update` will
# then sync over SSH from here on, without needing gh's credential helper.
set -euo pipefail

cd "{{ .chezmoi.sourceDir }}"

if [ ! -f "{{ .chezmoi.homeDir }}/.ssh/id_ed25519" ]; then
    echo "==> SSH key not present yet, leaving git remote as-is" >&2
    exit 0
fi

CURRENT_URL="$(git remote get-url origin)"
case "$CURRENT_URL" in
    https://github.com/*)
        SSH_URL="git@github.com:${CURRENT_URL#https://github.com/}"
        git remote set-url origin "$SSH_URL"
        echo "==> switched dotfiles remote to $SSH_URL"
        ;;
    *)
        echo "==> remote already non-HTTPS ($CURRENT_URL), nothing to do"
        ;;
esac
